# Copy to brain/.env and fill in. NEVER commit .env. (Live API keys live only in the
# Cloudflare Worker, never the browser; these brain-side keys are for batch calls only.)

# --- Knowledge graph (P12): an OKF Markdown bundle — no database server. Defaults to
#     {BUS_ROOT}/graph, but SET THIS TO A LOCAL PATH if your bus is on a Drive/Dropbox virtual
#     drive (P14). The brain rewrites whole node files on every touch and rewrites both endpoints
#     of every edge, so one round is hundreds of atomic writes — enough small-file churn to exhaust
#     Google Drive's FS driver and fail the round with WinError 1450. The bundle is brain-private
#     (the PWA never reads it), so keep it local and let git version it instead. ---
GRAPH_ROOT=./_graph

# --- DeepSeek (batch extraction/adjudication; Phase 2+) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- ElevenLabs (voice; Phase 7, used by the Worker, not the brain) ---
ELEVENLABS_API_KEY=

# --- Sync bus (Phase 8) ---
BUS_ROOT=./_bus

# --- Sync-drive resilience (P14): retry budget per filesystem operation on the bus. Defaults span
#     ~15s of backoff. Raise attempts if Drive is habitually slow; set 1 to fail fast instead. ---
# FS_RETRY_ATTEMPTS=6
# FS_RETRY_BASE_DELAY=0.5

# --- LLM JSON resilience: the batch model occasionally returns a 200 with an empty or non-JSON
#     body. The SDK retries HTTP errors, not that, so the provider re-asks. Set 1 to disable. ---
# LLM_JSON_ATTEMPTS=3
# LLM_JSON_BASE_DELAY=1.0
